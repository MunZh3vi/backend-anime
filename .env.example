PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# CORS - dominios separados por coma que pueden consumir la API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Prisma). En Railway, referenciar la variable del plugin Postgres:
# ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://user:password@localhost:5432/anime_backend

# Auth JWT - generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=12

# HTTP
HTTP_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=15000

# Cache TTL en segundos
CACHE_TTL_CATALOG=3600
CACHE_TTL_EPISODE=600

# Rate limit (por IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Proxy de imagenes: hosts permitidos separados por coma (protección anti-SSRF)
IMAGE_PROXY_ALLOWED_HOSTS=animeflv.net,www3.animeflv.net,www4.animeflv.net,cdn.animeflv.net,animeav1.com,cdn.animeav1.com,jkanime.net,tioanime.com,monoschinos2.com,hentaila.com

# Dominio por defecto para AnimeAV1 (cambia si el mirror rota) y para AnimeFLV
DEFAULT_ANIME_DOMAIN=animeav1.com
ANIMEFLV_DOMAIN=animeflv.net

# Puppeteer: paginas simultaneas maximas (RAM). Usado por resolvers protegidos
# (StreamWish/VOE/MP4Upload) y por el fallback de AnimeFLV cuando axios falla.
MAX_CONCURRENT_PAGES=2

# yt-dlp como resolver de alta velocidad opcional (requiere yt-dlp instalado en el sistema)
YTDLP_ENABLED=true
YTDLP_TIMEOUT_MS=8500

# Motor de descarga (guarda episodios en disco - ver advertencia en README del proyecto)
DOWNLOADS_DIR=downloads
DOWNLOAD_REQUEST_TIMEOUT_MS=120000
DEBUG_DOWNLOAD=false
