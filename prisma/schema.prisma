// Prisma schema — backend de anime (usuarios, favoritos, watchlist, historial)
// Docs: https://pris.ly/d/prisma-schema

// Generador clásico (prisma-client-js), no el nuevo "prisma-client": este
// último emite `import.meta.url` incluso al compilar a CommonJS, lo cual
// rompe en Node al ejecutarse en Linux (no se manifestaba en Windows).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String  @map("password_hash")
  avatarUrl    String? @map("avatar_url")
  bio          String?

  subscriptionStatus String @default("free") @map("subscription_status")
  role               Role   @default(USER)

  bannedAt  DateTime? @map("banned_at")
  banReason String?   @map("ban_reason")

  // TOTP (Google Authenticator y similares). El secreto solo se guarda una
  // vez confirmado con un código válido en /user/2fa/enable.
  twoFactorSecret  String? @map("two_factor_secret")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  // Gatea el acceso a proveedores +18 (hoy, HentaiLA). Default false: hay
  // que optar explícitamente, no al revés.
  matureContentEnabled Boolean @default(false) @map("mature_content_enabled")

  // FRIENDS se comporta igual que PRIVATE hasta que exista un sistema de
  // amistades: se deja modelado desde ya para no requerir otra migración.
  profileVisibility ProfileVisibility @default(PRIVATE) @map("profile_visibility")

  isEmailVerified          Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken   String?   @unique @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  favorites       Favorite[]
  watchlist       WatchlistItem[]
  history         WatchHistoryEntry[]
  comments        Comment[]
  commentLikes    CommentLike[]
  ratings         Rating[]
  commentReports  CommentReport[]
  notifications   Notification[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  // Metadata de sesión: qué dispositivo/IP la generó, para que el usuario
  // pueda reconocer y cerrar sesiones individuales desde /user/sessions.
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  animeId   String   @map("anime_id")
  title     String
  image     String?
  rating    Float?
  type      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("favorites")
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  animeId   String   @map("anime_id")
  title     String
  image     String?
  rating    Float?
  type      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("watchlist_items")
}

model WatchHistoryEntry {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  animeId         String   @map("anime_id")
  animeTitle      String   @map("anime_title")
  image           String?
  episodeId       String   @map("episode_id")
  episodeTitle    String   @map("episode_title")
  progressSeconds Int?     @map("progress_seconds")
  durationSeconds Int?     @map("duration_seconds")
  watchedAt       DateTime @default(now()) @updatedAt @map("watched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, watchedAt])
  @@map("watch_history")
}

// Comentarios por anime y, opcionalmente, por episodio (episodeId null =
// comentario general de la ficha). Con hilos: parentId apunta al comentario
// padre. Borrado es lógico (deletedAt) para no huerfanar respuestas cuando
// se borra un comentario que tiene hijos.
model Comment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  animeId   String    @map("anime_id")
  episodeId String?   @map("episode_id")
  parentId  String?   @map("parent_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([animeId, episodeId, parentId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// Calificación propia de un usuario (1-10), separada del "score" que ya
// viene de los proveedores (AnimeFLV/AnimeAV1/etc). La ficha puede mostrar
// ambas notas por separado.
model Rating {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  animeId   String   @map("anime_id")
  score     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([animeId])
  @@map("ratings")
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model CommentReport {
  id         String       @id @default(uuid())
  commentId  String       @map("comment_id")
  reporterId String       @map("reporter_id")
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // Sin relación a Comment con onDelete: Cascade a propósito: el reporte
  // debe sobrevivir aunque el comentario se borre (borrado lógico igual lo
  // deja disponible, pero por si el dato se purga después).
  @@unique([commentId, reporterId])
  @@index([status])
  @@map("comment_reports")
}

enum NotificationType {
  COMMENT_REPLY
  NEW_EPISODE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  // Datos libres para que el frontend arme el link (animeId, episodeId,
  // commentId, según el tipo) sin necesitar una tabla por tipo de evento.
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

// Último conteo de episodios visto para un anime en watchlist de alguien.
// El cron de notificaciones lo compara contra el conteo actual del scraper
// para detectar episodios nuevos sin volver a notificar los mismos.
model AnimeEpisodeTracker {
  animeId          String   @id @map("anime_id")
  lastEpisodeCount Int      @map("last_episode_count")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("anime_episode_trackers")
}
